# Optional local overrides.
#
# The app already ships with working defaults for its Supabase project in
# src/integrations/supabase/config.ts, so you do NOT need this file to run or
# deploy. Copy it to .env only to point a local build at a different Supabase
# project (Project Settings → API in the Supabase dashboard).
#
# Only VITE_-prefixed vars reach client code. Note that Vercel ignores committed
# .env files during builds — set these in Project Settings → Environment
# Variables there instead.
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
