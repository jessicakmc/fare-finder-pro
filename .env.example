# Required. Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API).
#
# VITE_SUPABASE_PUBLISHABLE_KEY takes the publishable key (sb_publishable_*) —
# the current name for what used to be called the anon key. It is browser-safe
# and gated by Row Level Security. Never put a service-role / secret key here.
#
# Only VITE_-prefixed variables reach client code. Vercel ignores committed .env
# files during builds, so for deployments set these two in the Vercel dashboard
# under Project Settings → Environment Variables instead.
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
